---
/**
 * Feuillet de vélin (la PSSI) au coin replié, ses lignes de texte, et un sceau doré :
 * le document de référence, validé. Pendant du point rouge de Beffroi (le risque).
 */
interface Props { size?: number; inverted?: boolean }
const { size = 32, inverted = false } = Astro.props;
const sheet = inverted ? "#ffffff" : "#6b1d2e";
const ink = inverted ? "#6b1d2e" : "#ffffff";
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width={size} height={size} aria-hidden="true">
  <path d="M10 4h19l9 9v29a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" fill={sheet} />
  <path d="M29 4v7a2 2 0 0 0 2 2h7Z" fill={ink} opacity="0.55" />
  <rect x="13" y="17" width="20" height="2.6" rx="1.3" fill={ink} />
  <rect x="13" y="23" width="20" height="2.6" rx="1.3" fill={ink} />
  <rect x="13" y="29" width="11" height="2.6" rx="1.3" fill={ink} />
  <path d="M30.5 40.5 29 47l3.5-2 3.5 2-1.5-6.5Z" fill="#8a6418" />
  <circle cx="32.5" cy="36" r="7" fill="#b8862b" stroke={inverted ? "#6b1d2e" : "#ffffff"} stroke-width="1.6" />
  <circle cx="32.5" cy="36" r="3.6" fill="none" stroke="#f3dca6" stroke-width="1.2" />
</svg>
