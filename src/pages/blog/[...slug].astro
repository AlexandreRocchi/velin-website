---
import { render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts, formatDate, readingTime } from "../../lib/posts";
import { SITE, url } from "../../lib/site";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <header class="article-head">
    <div class="wrap">
      <a class="back" href={url("blog")}>← Tous les articles</a>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <div class="post-meta">
        <span>{post.data.author}</span>
        <time datetime={post.data.date.toISOString()}>· {formatDate(post.data.date)}</time>
        <span>· {readingTime(post.body)} min de lecture</span>
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </div>
  </header>
  <div class="wrap">
    <article class="prose">
      <Content />
      <hr />
      <p class="muted">
        Une question, une remarque ? Ouvrez une <a href={`${SITE.github}/issues`} rel="noopener">issue sur GitHub</a>.
      </p>
    </article>
  </div>
</Base>
